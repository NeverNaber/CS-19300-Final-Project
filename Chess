import java.io.IOException;
import javax.swing.*;
import javax.swing.SwingUtilities;
import java.awt.Color;
import java.awt.Graphics;
import java.awt.BorderLayout;
import java.awt.Dimension;
import java.awt.Font;
import java.util.ArrayList;
import java.util.List;
public class Main {
    public static void main(String[] args) throws IOException{
        SwingUtilities.invokeLater(() ->  {
            JPanel panel = new JPanel(null);
            JPanel canvas = new DrawingPanel();
            JPanel mainPanel = new JPanel(new BorderLayout());
            JTextField text = new JTextField();
            JFrame frame = new JFrame("Chess");
            JLabel label1 = new JLabel("White: Choose a square to move from");
            label1.setFont(new Font("SansSerif", Font.PLAIN, 50));
            panel.setPreferredSize(new Dimension(1200, 300));
            panel.add(text);
            panel.add(label1);
            text.setBounds(655, 140, 400, 100);
            label1.setBounds(100, -130, 1500, 400);
            text.setHorizontalAlignment(JTextField.CENTER);
            label1.setHorizontalAlignment(JLabel.CENTER);
            text.setFont(new Font("SansSerif", Font.PLAIN, 50));
            mainPanel.add(canvas, BorderLayout.CENTER);
            mainPanel.add(panel, BorderLayout.SOUTH);
            frame.add(mainPanel);
            frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
            frame.setSize(500, 500);
            frame.setExtendedState(JFrame.MAXIMIZED_BOTH);
            frame.setVisible(true);
        });
    }
}
public class DrawingPanel extends JPanel {
    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        int count;
        String letter = "A";
        ArrayList<String> pieces = new ArrayList<>(List.of("♜", "♞", "♝", "♛", "♚", "♝", "♞", "♜", "♟", "♟", "♟", "♟", "♟", "♟", "♟", "♟", "♟", "♟", "♟", "♟", "♟", "♟", "♟", "♟", "♜", "♞", "♝", "♛", "♚", "♝", "♞", "♜"));
        int pieceCount = 0;
        for (int r = 0; r < 8; r++) {
            count = r % 2;
            for (int c = 0; c < 8; c++) {
                if (count == 0) {
                    g.setColor(Color.DARK_GRAY);
                    count = 1;
                } else if (count == 1) {
                    g.setColor(Color.LIGHT_GRAY);
                    count = 0;
                }
                g.fillRect(c * 83 + (getWidth() / 2) - 332, 5 + r * 83, 83, 83);
                g.setColor(Color.LIGHT_GRAY);
                g.drawRect(c * 83 + (getWidth() / 2) - 332, 5 + r * 83, 83, 83);
                g.setColor(Color.BLACK);
                g.setFont(new Font("SansSerif", Font.PLAIN, 25));
                if (r == 7) {
                    if (c == 0) {
                        letter = "A";
                    } else if (c == 1) {
                        letter = "B";
                    } else if (c == 2) {
                        letter = "C";
                    } else if (c == 3) {
                        letter = "D";
                    } else if (c == 4) {
                        letter = "E";
                    } else if (c == 5) {
                        letter = "F";
                    } else if (c == 6) {
                        letter = "G";
                    } else if (c == 7) {
                        letter = "H";
                    }
                    g.drawString(letter, c * 83 + 32 + (getWidth() / 2) - 332, 110 + r * 83);
                }
                String letter2 = String.valueOf(8 - r);
                if (c == 0) {
                    g.drawString(letter2, c * 83 - 20 + (getWidth() / 2) - 332, 50 + r * 83);
                }
                if (r == 0 || r == 1) {
                    g.setColor(Color.BLACK);
                    g.setFont(new Font("SansSerif", Font.PLAIN, 60));
                    g.drawString(pieces.get(pieceCount), c * 83 + (getWidth() / 2) - 321, -11 + (r+1) * 83);
                    pieceCount++;
                }
                if (r == 6 || r == 7) {
                    g.setColor(Color.WHITE);
                    g.setFont(new Font("SansSerif", Font.PLAIN, 60));
                    g.drawString(pieces.get(pieceCount), c * 83 + (getWidth() / 2) - 321, -11 + (r+1) * 83);
                    pieceCount++;
                }
            }
        }
    }
}
