            }
        });    
    }







    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        int count;
        String letter = "A";
        for (int r = 0; r < 8; r++) {
            count = r % 2;
            for (int c = 0; c < 8; c++) {

                // This makes the 8x8 square of the board.
                if (count == 0) {
                    g.setColor(Color.DARK_GRAY);
                    count = 1;
                } else if (count == 1) {
                    g.setColor(Color.LIGHT_GRAY);
                    count = 0;
                }
                g.fillRect(c * 83 + (getWidth() / 2) - 332, 5 + (7 - r) * 83, 83, 83);
                g.setColor(Color.LIGHT_GRAY);
                g.drawRect(c * 83 + (getWidth() / 2) - 332, 5 + (7 - r) * 83, 83, 83);
                g.setColor(Color.BLACK);


                // This code writes the 8 files of the chess board, represented by the letters at the bottom
                g.setFont(new Font("SansSerif", Font.PLAIN, 25));
                if (r == 7) {
                    if (c == 0) {
                        letter = "A";
                    } else if (c == 1) {
                        letter = "B";
                    } else if (c == 2) {
                        letter = "C";
                    } else if (c == 3) {
                        letter = "D";
                    } else if (c == 4) {
                        letter = "E";
                    } else if (c == 5) {
                        letter = "F";
                    } else if (c == 6) {
                        letter = "G";
                    } else if (c == 7) {
                        letter = "H";
                    }
                    g.drawString(letter, c * 83 + 32 + (getWidth() / 2) - 332, 110 + r * 83);
                }

                // This code writes the 8 ranks of the chess board, represented by the numbers on the left side
                String letter2 = String.valueOf(8 - r);
                if (c == 0) {
                    g.drawString(letter2, c * 83 - 20 + (getWidth() / 2) - 332, 50 + r * 83);
                }


                // This redraws all the remaining chess pieces where they belong on the board
                for (int i = 0; i < pieces.size(); i++) {
                    if (pieces.get(i).getAlive() == true) {
                        g.setFont(new Font("SansSerif", Font.PLAIN, 75));
                        if (pieces.get(i).getColor().equals("White")) {
                            g.setColor(Color.WHITE);
                        } else {
                            g.setColor(Color.BLACK);
                        }
                        g.drawString(pieces.get(i).getType(), pieces.get(i).getC() * 83 + (getWidth() / 2) - 327, -8 + (7 - pieces.get(i).getR() + 1) * 83);
                    }
                }
            }
        }
    }
