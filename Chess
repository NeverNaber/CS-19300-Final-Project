public class Piece {
    private int r;
    private int c;
    private String color;
    private String type;
    private boolean alive;
    public Piece(int r, int c, String color, String type, boolean alive) {
        this.r = r;
        this.c = c;
        this.color = color;
        this.type = type;
        this.alive = alive;
    }
    public String getType() {
        return type;
    }
    public String getColor() {
        return color;
    }
    public int getC() {
        return c;
    }
    public int getR() {
        return r;
    }
    public boolean getAlive() {
        return alive;
    }
    public void setR(int r) {
        this.r = r;
    }
    public void setC(int c) {
        this.c = c;
    }
    public void setAlive(boolean alive) {
        this.alive = alive;
    }
}
